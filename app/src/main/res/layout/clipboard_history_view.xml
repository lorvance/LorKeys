<helium314.keyboard.keyboard.clipboard.ClipboardHistoryView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:visibility="gone"
    android:background="@android:color/transparent"
    android:paddingTop="6dp"
    style="?attr/clipboardHistoryViewStyle">

    <LinearLayout
        android:id="@+id/clipboard_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/clipboard_back_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/abc_action_bar_up_description"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/clipboard_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="@string/clipboard"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/clipboard_clear_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/clear_clipboard" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/clipboard_empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="invisible"
            android:text="¯\\_(ツ)_/¯"
            tools:ignore="HardcodedText" />

        <helium314.keyboard.keyboard.clipboard.ClipboardHistoryRecyclerView
            android:id="@+id/clipboard_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"/>

        <LinearLayout
            android:id="@+id/clipboard_undo_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"
            android:paddingVertical="5dp"
            android:elevation="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/clipboard_undo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clipboard_clip_deleted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/clipboard_undo_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:gravity="center"
                android:text="@string/undo"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/clipboard_tips_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/clipboard_tips_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clipboard_tips_section_header"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/clipboard_tips_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dialog_close"
                android:src="@drawable/ic_close"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:id="@+id/clipboard_tip_card_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/clipboard_tip_icon_1"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/sym_keyboard_clipboard_rounded"
                    android:contentDescription="@null"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/clipboard_tip_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/clipboard_tip_gboard_welcome"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/clipboard_tip_card_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/clipboard_tip_icon_2"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/sym_keyboard_paste_rounded"
                    android:contentDescription="@null"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/clipboard_tip_text_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/clipboard_tip_gboard_paste"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/clipboard_tip_card_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/clipboard_tip_icon_3"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_edit"
                    android:contentDescription="@null"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/clipboard_tip_text_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/clipboard_tip_gboard_edit"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/clipboard_tip_card_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/clipboard_tip_icon_4"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_clipboard_pin_rounded"
                    android:contentDescription="@null"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/clipboard_tip_text_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/clipboard_tip_gboard_pin"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <helium314.keyboard.keyboard.MainKeyboardView
        android:id="@+id/bottom_row_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</helium314.keyboard.keyboard.clipboard.ClipboardHistoryView>
